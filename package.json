{
  "name": "php2shell-labs",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1 --port 5190",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "bun test --timeout 60000 tests",
    "test:unit": "bun run scripts/test-unit.ts",
    "build": "bun run check && vite build --config web/vite.config.ts",
    "engine": "bun run engine/server.ts",
    "scan": "bun run engine/cli.ts",
    "deploy:engine": "fly deploy --config fly.toml --remote-only",
    "deploy:edge": "bun run build && wrangler deploy",
    "edge:dev": "wrangler dev --port 8789",
    "render": "bun run render/server.ts",
    "deploy:render": "fly deploy --config fly.render.toml --remote-only --ha=false"
  },
  "dependencies": {
    "@arwes/react": "1.0.0-alpha.23",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "^4.151.1"
  }
}
